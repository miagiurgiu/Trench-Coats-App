     <property name="styleSheet">
      <string notr="true">QTabWidget::pane {
    background: transparent;
    border: 1px solid rgba(246, 219, 192, 28);
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    color: rgba(248, 244, 233, 180);
    background: #190019;
    border: 1px solid rgba(246, 219, 192, 25);
    border-radius: 9px;
    padding: 9px 22px;
    margin-right: 4px;
    min-width: 100px;

    font-family: &quot;Inter&quot;, &quot;SF Pro Text&quot;, &quot;Helvetica Neue&quot;;
    font-size: 14px;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #F8F4E9;
    background: #37203B;
    border: 1px solid rgba(246, 219, 192, 65);
}

QTabBar::tab:selected {
    color: #F8F4E9;
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #37203B,
        stop: 1 #502D55
    );
    border: 1px solid #935073;
}
QTabWidget::pane {
    background: rgba(11, 0, 11, 115);
    border: 1px solid rgba(246, 219, 192, 30);
    border-radius: 14px;
    top: -1px;
}</string>
