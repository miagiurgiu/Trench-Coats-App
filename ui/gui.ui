     <widget class="QWidget" name="adminTab">
      <property name="styleSheet">
       <string notr="true">QWidget#adminTab {
    color: #F8F4E9;
    font-family: &quot;Inter&quot;, &quot;SF Pro Text&quot;, &quot;SF Pro Display&quot;, &quot;Helvetica Neue&quot;;
    font-size: 14px;

    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 #0B000B,
        stop: 0.35 #190019,
        stop: 0.72 #2E1732,
        stop: 1 #502D55
    );
}

/* Labels */

QWidget#adminTab QLabel {
    color: #F6DBC0;
    background: transparent;
    font-size: 14px;
    font-weight: 600;
}

/* Input fields */

QWidget#adminTab QLineEdit {
    color: #F8F4E9;
    background: rgba(11, 0, 11, 205);
    border: 1px solid rgba(246, 219, 192, 38);
    border-radius: 10px;
    padding: 8px 12px;
    min-height: 23px;
    selection-color: #F8F4E9;
    selection-background-color: #935073;
}

QWidget#adminTab QLineEdit:hover {
    background: rgba(25, 0, 25, 220);
    border: 1px solid rgba(246, 219, 192, 75);
}

QWidget#adminTab QLineEdit:focus {
    background: #190019;
    border: 1px solid #935073;
}

/* Default buttons */

QWidget#adminTab QPushButton {
    color: #F8F4E9;
    background: rgba(80, 45, 85, 115);
    border: 1px solid rgba(246, 219, 192, 45);
    border-radius: 10px;
    padding: 9px 16px;
    min-height: 23px;
    font-size: 14px;
    font-weight: 600;
}

QWidget#adminTab QPushButton:hover {
    background: rgba(80, 45, 85, 180);
    border: 1px solid rgba(246, 219, 192, 90);
}

QWidget#adminTab QPushButton:pressed {
    background: #190019;
    border: 1px solid #935073;
    padding-top: 11px;
    padding-bottom: 7px;
}

/* Add — primary violet action */

QWidget#adminTab QPushButton#addButton {
    color: #F8F4E9;
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #37203B,
        stop: 1 #502D55
    );
    border: 1px solid #935073;
    font-weight: 700;
}

QWidget#adminTab QPushButton#addButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #502D55,
        stop: 1 #68406D
    );
}

/* Delete — accent outline only */

QWidget#adminTab QPushButton#deleteButton {
    color: #F6DBC0;
    background: rgba(11, 0, 11, 105);
    border: 1px solid rgba(147, 80, 115, 135);
}

QWidget#adminTab QPushButton#deleteButton:hover {
    background: rgba(147, 80, 115, 42);
    border: 1px solid #935073;
}

/* Update */

QWidget#adminTab QPushButton#updateButton {
    background: rgba(80, 45, 85, 115);
}

/* Display */

QWidget#adminTab QPushButton#displayButton {
    color: #190019;
    background: #F6DBC0;
    border: 1px solid #F8F4E9;
    font-weight: 700;
}

QWidget#adminTab QPushButton#displayButton:hover {
    color: #0B000B;
    background: #F8F4E9;
}

/* Undo and Redo — quieter secondary actions */

QWidget#adminTab QPushButton#undoButton,
QWidget#adminTab QPushButton#redoButton {
    color: rgba(248, 244, 233, 190);
    background: rgba(11, 0, 11, 105);
    border: 1px solid rgba(246, 219, 192, 30);
    font-weight: 500;
}

QWidget#adminTab QPushButton#undoButton:hover,
QWidget#adminTab QPushButton#redoButton:hover {
    color: #F8F4E9;
    background: rgba(80, 45, 85, 125);
    border: 1px solid rgba(246, 219, 192, 70);
}

/* Confirm */

QWidget#adminTab QPushButton#confirmButton {
    color: #190019;
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #F6DBC0,
        stop: 1 #F8F4E9
    );
    border: 1px solid rgba(147, 80, 115, 130);
    font-weight: 700;
}

QWidget#adminTab QPushButton#confirmButton:hover {
    background: #F8F4E9;
    border: 1px solid #935073;
}

/* Inventory table */

QWidget#adminTab QTableWidget {
    color: #F8F4E9;
    background: rgba(11, 0, 11, 215);
    alternate-background-color: rgba(80, 45, 85, 35);
    border: 1px solid rgba(246, 219, 192, 35);
    border-radius: 13px;
    gridline-color: rgba(246, 219, 192, 15);
    outline: none;
}

QWidget#adminTab QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid rgba(246, 219, 192, 10);
}

QWidget#adminTab QTableWidget::item:hover {
    background: rgba(80, 45, 85, 80);
}

QWidget#adminTab QTableWidget::item:selected {
    color: #F8F4E9;
    background: rgba(147, 80, 115, 125);
}

/* Table header */

QWidget#adminTab QHeaderView::section {
    color: #F6DBC0;
    background: rgba(25, 0, 25, 225);
    border: none;
    border-right: 1px solid rgba(246, 219, 192, 18);
    border-bottom: 1px solid rgba(147, 80, 115, 80);
    padding: 10px;
    font-weight: 700;
}

QWidget#adminTab QTableCornerButton::section {
    background: #190019;
    border: none;
}

/* Scrollbar */

QWidget#adminTab QScrollBar:vertical {
    background: #0B000B;
    width: 8px;
    margin: 3px;
}

QWidget#adminTab QScrollBar::handle:vertical {
    background: #502D55;
    border-radius: 4px;
    min-height: 28px;
}

QWidget#adminTab QScrollBar::handle:vertical:hover {
    background: #935073;
}

QWidget#adminTab QScrollBar::add-line:vertical,
QWidget#adminTab QScrollBar::sub-line:vertical {
    height: 0px;
}</string>
