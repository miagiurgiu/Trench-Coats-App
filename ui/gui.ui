      <property name="styleSheet">
       <string notr="true">QWidget#userTab {
    color: #F8F4E9;
    font-family: &quot;Inter&quot;, &quot;SF Pro Text&quot;, &quot;Helvetica Neue&quot;;
    font-size: 14px;

    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 #0B000B,
        stop: 0.40 #190019,
        stop: 0.75 #29142D,
        stop: 1 #432548
    );
}

/* Labels */

QWidget#userTab QLabel {
    color: #F6DBC0;
    background: transparent;
    font-family: &quot;Inter&quot;, &quot;SF Pro Text&quot;, &quot;Helvetica Neue&quot;;
    font-size: 14px;
    font-weight: 600;
}

/* User input */

QWidget#userTab QLineEdit {
    color: #F8F4E9;
    background: rgba(11, 0, 11, 210);
    border: 1px solid rgba(246, 219, 192, 40);
    border-radius: 10px;
    padding: 8px 12px;
    min-height: 24px;

    font-family: &quot;Inter&quot;, &quot;SF Pro Text&quot;, &quot;Helvetica Neue&quot;;
    font-size: 14px;

    selection-color: #F8F4E9;
    selection-background-color: #935073;
}

QWidget#userTab QLineEdit:hover {
    border: 1px solid rgba(246, 219, 192, 80);
}

QWidget#userTab QLineEdit:focus {
    background: #190019;
    border: 1px solid #935073;
}

/* Current coat card */

QWidget#userTab QLabel#currentCoatLabel {
    color: #F8F4E9;
    background: rgba(11, 0, 11, 185);
    border: 1px solid rgba(246, 219, 192, 38);
    border-radius: 14px;
    padding: 18px;

    font-family: &quot;Inter&quot;, &quot;SF Pro Text&quot;, &quot;Helvetica Neue&quot;;
    font-size: 15px;
    font-weight: 500;
}

/* Default buttons */

QWidget#userTab QPushButton {
    color: #F8F4E9;
    background: rgba(80, 45, 85, 110);
    border: 1px solid rgba(246, 219, 192, 42);
    border-radius: 10px;
    padding: 9px 16px;
    min-height: 24px;

    font-family: &quot;Inter&quot;, &quot;SF Pro Text&quot;, &quot;Helvetica Neue&quot;;
    font-size: 14px;
    font-weight: 600;
}

QWidget#userTab QPushButton:hover {
    background: rgba(80, 45, 85, 180);
    border: 1px solid rgba(246, 219, 192, 90);
}

QWidget#userTab QPushButton:pressed {
    background: #190019;
    border: 1px solid #935073;
}

/* Filter */

QWidget#userTab QPushButton#filterButton {
    background: #502D55;
    border: 1px solid #935073;
    font-weight: 700;
}

QWidget#userTab QPushButton#filterButton:hover {
    background: #68406D;
}

/* Add to basket — main user action */

QWidget#userTab QPushButton#addToBasketButton {
    color: #190019;
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #F6DBC0,
        stop: 1 #F8F4E9
    );
    border: 1px solid rgba(147, 80, 115, 130);
    font-weight: 700;
}

QWidget#userTab QPushButton#addToBasketButton:hover {
    color: #0B000B;
    background: #F8F4E9;
    border: 1px solid #935073;
}

/* Next */

QWidget#userTab QPushButton#nextButton {
    background: rgba(80, 45, 85, 140);
}

/* Secondary basket actions */

QWidget#userTab QPushButton#openBasketButton,
QWidget#userTab QPushButton#basketTableButton {
    color: rgba(248, 244, 233, 210);
    background: rgba(11, 0, 11, 120);
    border: 1px solid rgba(246, 219, 192, 35);
}

/* Shopping basket */

QWidget#userTab QListWidget {
    color: #F8F4E9;
    background: rgba(11, 0, 11, 215);
    alternate-background-color: rgba(80, 45, 85, 30);
    border: 1px solid rgba(246, 219, 192, 35);
    border-radius: 13px;
    padding: 6px;

    font-family: &quot;Inter&quot;, &quot;SF Pro Text&quot;, &quot;Helvetica Neue&quot;;
    font-size: 14px;
    outline: none;
}

QWidget#userTab QListWidget::item {
    padding: 9px;
    border-bottom: 1px solid rgba(246, 219, 192, 12);
}

QWidget#userTab QListWidget::item:hover {
    background: rgba(80, 45, 85, 75);
}

QWidget#userTab QListWidget::item:selected {
    color: #F8F4E9;
    background: rgba(147, 80, 115, 115);
}

/* Total */

QWidget#userTab QLabel#totalLabel {
    color: #F8F4E9;
    background: rgba(80, 45, 85, 85);
    border-left: 3px solid #935073;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 16px;
    font-weight: 700;
}</string>
